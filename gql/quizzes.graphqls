# Quiz queries and mutations

# ==================== Quiz Types ====================

enum QuizQuestionType {
    PREDEFINED
    FREE_TEXT
    NUMBER
    JSON
    ORDERING
}

# How a predefined question's alternatives are labelled. The label is derived
# from the answer's position when it is rendered, never stored per answer:
# answers are always served in answer_order, so a derived label cannot
# disagree with the order they are shown in, and it stays out of the
# translated answer text.
enum QuizAnswerLabelStyle {
    NONE
    NUMERIC
    ALPHA
}

type Quiz {
    id: ID!
    name: String!
    description: String!
    image: Image @goField(forceResolver: true)
    project: Project! @goField(forceResolver: true)
    challenge: Challenge! @goField(forceResolver: true)

    timeoutSeconds: Int
    randomizeQuestions: Boolean!
    revealCorrectAnswers: Boolean!
    allowRetakes: Boolean!
    completionPoints: Int!

    questions: [QuizQuestion!]! @goField(forceResolver: true)

    endTime: DateTime

    # User-specific fields (legacy - prefer session-based access)
    userSubmissions: [QuizSubmission!]! @goField(forceResolver: true)
    userCanStart: Boolean! @goField(forceResolver: true)
    userActiveSubmission: QuizSubmission @goField(forceResolver: true)

    # Session-based access (new)
    sessions(state: QuizSessionState): [QuizSession!]! @goField(forceResolver: true)
    userSessions: [QuizSession!]! @goField(forceResolver: true)
    userActiveSession: QuizSession @goField(forceResolver: true)
    translationStatus: [TranslationFieldStatus!]! @goField(forceResolver: true)
}

# ==================== Quiz Question Interface ====================

interface QuizQuestion {
    id: ID!
    quiz: Quiz! @goField(forceResolver: true)
    questionText: String!
    # Shown above the question text; null when the question has no image.
    image: Image @goField(forceResolver: true)
    questionOrder: Int!
    timeoutSeconds: Int
    points: Int
    bettingEnabled: Boolean!
    bettingMinPercentage: Float
    bettingMaxPercentage: Float
    bettingMinAbsolute: Int
    bettingMaxAbsolute: Int
    bettingMultiplierCorrect: Float
    bettingMultiplierWrong: Float
    translationStatus: [TranslationFieldStatus!]! @goField(forceResolver: true)
}

type PredefinedQuestion implements QuizQuestion {
    id: ID!
    quiz: Quiz! @goField(forceResolver: true)
    questionText: String!
    # Shown above the question text; null when the question has no image.
    image: Image @goField(forceResolver: true)
    questionOrder: Int!
    timeoutSeconds: Int
    points: Int
    bettingEnabled: Boolean!
    bettingMinPercentage: Float
    bettingMaxPercentage: Float
    bettingMinAbsolute: Int
    bettingMaxAbsolute: Int
    bettingMultiplierCorrect: Float
    bettingMultiplierWrong: Float
    translationStatus: [TranslationFieldStatus!]! @goField(forceResolver: true)
    allowMultipleSelection: Boolean!
    answerLabelStyle: QuizAnswerLabelStyle!
    predefinedAnswers: [QuizPredefinedAnswer!]! @goField(forceResolver: true)
}

type FreeTextQuestion implements QuizQuestion {
    id: ID!
    quiz: Quiz! @goField(forceResolver: true)
    questionText: String!
    # Shown above the question text; null when the question has no image.
    image: Image @goField(forceResolver: true)
    questionOrder: Int!
    timeoutSeconds: Int
    points: Int
    bettingEnabled: Boolean!
    bettingMinPercentage: Float
    bettingMaxPercentage: Float
    bettingMinAbsolute: Int
    bettingMaxAbsolute: Int
    bettingMultiplierCorrect: Float
    bettingMultiplierWrong: Float
    translationStatus: [TranslationFieldStatus!]! @goField(forceResolver: true)
}

type NumberQuestion implements QuizQuestion {
    id: ID!
    quiz: Quiz! @goField(forceResolver: true)
    questionText: String!
    # Shown above the question text; null when the question has no image.
    image: Image @goField(forceResolver: true)
    questionOrder: Int!
    timeoutSeconds: Int
    points: Int
    bettingEnabled: Boolean!
    bettingMinPercentage: Float
    bettingMaxPercentage: Float
    bettingMinAbsolute: Int
    bettingMaxAbsolute: Int
    bettingMultiplierCorrect: Float
    bettingMultiplierWrong: Float
    translationStatus: [TranslationFieldStatus!]! @goField(forceResolver: true)
    minValue: Float
    maxValue: Float
    stepValue: Float
}

type JsonQuestion implements QuizQuestion {
    id: ID!
    quiz: Quiz! @goField(forceResolver: true)
    questionText: String!
    # Shown above the question text; null when the question has no image.
    image: Image @goField(forceResolver: true)
    questionOrder: Int!
    timeoutSeconds: Int
    points: Int
    bettingEnabled: Boolean!
    bettingMinPercentage: Float
    bettingMaxPercentage: Float
    bettingMinAbsolute: Int
    bettingMaxAbsolute: Int
    bettingMultiplierCorrect: Float
    bettingMultiplierWrong: Float
    translationStatus: [TranslationFieldStatus!]! @goField(forceResolver: true)
}

type OrderingQuestion implements QuizQuestion {
    id: ID!
    quiz: Quiz! @goField(forceResolver: true)
    questionText: String!
    # Shown above the question text; null when the question has no image.
    image: Image @goField(forceResolver: true)
    questionOrder: Int!
    timeoutSeconds: Int
    points: Int
    bettingEnabled: Boolean!
    bettingMinPercentage: Float
    bettingMaxPercentage: Float
    bettingMinAbsolute: Int
    bettingMaxAbsolute: Int
    bettingMultiplierCorrect: Float
    bettingMultiplierWrong: Float
    translationStatus: [TranslationFieldStatus!]! @goField(forceResolver: true)
    orderingItems: [QuizOrderingItem!]! @goField(forceResolver: true)
}

type QuizOrderingItem {
    id: ID!
    question: QuizQuestion! @goField(forceResolver: true)
    itemText: String!
    # correctOrder is conditionally exposed - only returns value when session is FINISHED to prevent cheating
    correctOrder: Int @goField(forceResolver: true)
}

type QuizPredefinedAnswer {
    id: ID!
    question: QuizQuestion! @goField(forceResolver: true)
    answerText: String!
    # Optional explanation shown with the answer; null when there is none.
    description: String
    answerOrder: Int!
    # isCorrect is conditionally exposed - hidden from non-admins until the session is FINISHED to prevent cheating
    isCorrect: Boolean @goField(forceResolver: true)
    translationStatus: [TranslationFieldStatus!]! @goField(forceResolver: true)
}

type QuizSubmission {
    id: ID!
    quiz: Quiz! @goField(forceResolver: true)
    session: QuizSession @goField(forceResolver: true)
    user: User! @goField(forceResolver: true)

    startedAt: DateTime!
    completedAt: DateTime
    expiresAt: DateTime
    isExpired: Boolean! @goField(forceResolver: true)
    autoSubmitted: Boolean!

    questionOrder: [ID!]!
    orderedQuestions: [QuizQuestion!]! @goField(forceResolver: true)

    responses: [QuizResponse!]! @goField(forceResolver: true)

    score: Int
    maxScore: Int
    scorePercentage: Float @goField(forceResolver: true)
    pointsAwarded: Int
}

# ==================== Quiz Response Interface ====================

interface QuizResponse {
    id: ID!
    submission: QuizSubmission! @goField(forceResolver: true)
    question: QuizQuestion! @goField(forceResolver: true)
    answeredAt: DateTime
    timeSpentSeconds: Int
    pointsEarned: Int
    betAmount: Int
    journalEntry: ScoreJournal @goField(forceResolver: true)
    # isCorrect is conditionally exposed - only returned once the submission's session is no longer OPEN
    isCorrect: Boolean @goField(forceResolver: true)
}

type PredefinedResponse implements QuizResponse {
    id: ID!
    submission: QuizSubmission! @goField(forceResolver: true)
    question: QuizQuestion! @goField(forceResolver: true)
    answeredAt: DateTime
    timeSpentSeconds: Int
    pointsEarned: Int
    betAmount: Int
    journalEntry: ScoreJournal @goField(forceResolver: true)
    selectedAnswerIds: [ID!]!
    selectedAnswers: [QuizPredefinedAnswer!]! @goField(forceResolver: true)
    # isCorrect is conditionally exposed - only returned once the submission's session is no longer OPEN
    isCorrect: Boolean @goField(forceResolver: true)
}

type FreeTextResponse implements QuizResponse {
    id: ID!
    submission: QuizSubmission! @goField(forceResolver: true)
    question: QuizQuestion! @goField(forceResolver: true)
    answeredAt: DateTime
    timeSpentSeconds: Int
    pointsEarned: Int
    betAmount: Int
    journalEntry: ScoreJournal @goField(forceResolver: true)
    textResponse: String!
    # isCorrect is conditionally exposed - only returned once the submission's session is no longer OPEN
    isCorrect: Boolean @goField(forceResolver: true)
}

type NumberResponse implements QuizResponse {
    id: ID!
    submission: QuizSubmission! @goField(forceResolver: true)
    question: QuizQuestion! @goField(forceResolver: true)
    answeredAt: DateTime
    timeSpentSeconds: Int
    pointsEarned: Int
    betAmount: Int
    journalEntry: ScoreJournal @goField(forceResolver: true)
    numberResponse: Float!
    # isCorrect is conditionally exposed - only returned once the submission's session is no longer OPEN
    isCorrect: Boolean @goField(forceResolver: true)
}

type JsonResponse implements QuizResponse {
    id: ID!
    submission: QuizSubmission! @goField(forceResolver: true)
    question: QuizQuestion! @goField(forceResolver: true)
    answeredAt: DateTime
    timeSpentSeconds: Int
    pointsEarned: Int
    betAmount: Int
    journalEntry: ScoreJournal @goField(forceResolver: true)
    jsonResponse: JSON!
    # isCorrect is conditionally exposed - only returned once the submission's session is no longer OPEN
    isCorrect: Boolean @goField(forceResolver: true)
}

type OrderingResponse implements QuizResponse {
    id: ID!
    submission: QuizSubmission! @goField(forceResolver: true)
    question: QuizQuestion! @goField(forceResolver: true)
    answeredAt: DateTime
    timeSpentSeconds: Int
    pointsEarned: Int
    betAmount: Int
    journalEntry: ScoreJournal @goField(forceResolver: true)
    submittedOrder: [ID!]!
    # isCorrect is conditionally exposed - only returned once the submission's session is no longer OPEN
    isCorrect: Boolean @goField(forceResolver: true)
}

# ==================== Quiz Input Types ====================

input CreateQuizInput {
    name: String!
    description: String!
    imageUrl: String
    projectId: ID!
    challengeId: ID!

    timeoutSeconds: Int

    randomizeQuestions: Boolean!
    revealCorrectAnswers: Boolean!
    allowRetakes: Boolean!
    completionPoints: Int!

    endTime: DateTime
}

input UpdateQuizInput {
    name: String
    description: String
    imageUrl: String

    timeoutSeconds: Int

    randomizeQuestions: Boolean
    revealCorrectAnswers: Boolean
    allowRetakes: Boolean
    completionPoints: Int

    endTime: DateTime
}

input CreateQuizQuestionInput {
    questionType: QuizQuestionType!
    questionText: String!
    # URL of an image shown above the question. Blank is stored as no image.
    imageUrl: String
    questionOrder: Int!
    timeoutSeconds: Int
    points: Int

    bettingEnabled: Boolean
    bettingMinPercentage: Float
    bettingMaxPercentage: Float
    bettingMinAbsolute: Int
    bettingMaxAbsolute: Int
    bettingMultiplierCorrect: Float
    bettingMultiplierWrong: Float

    allowMultipleSelection: Boolean
    answerLabelStyle: QuizAnswerLabelStyle
    predefinedAnswers: [CreatePredefinedAnswerInput!]

    minValue: Float
    maxValue: Float
    stepValue: Float

    orderingItems: [CreateOrderingItemInput!]
}

input CreatePredefinedAnswerInput {
    answerText: String!
    # Optional; a blank value is stored as no description.
    description: String
    isCorrect: Boolean!
    answerOrder: Int!
}

input CreateOrderingItemInput {
    itemText: String!
    correctOrder: Int!
}

input UpdateQuizQuestionInput {
    questionText: String
    # URL of an image shown above the question. Omit to leave it alone; pass a
    # blank string to remove the image.
    imageUrl: String
    questionOrder: Int
    timeoutSeconds: Int
    points: Int

    bettingEnabled: Boolean
    bettingMinPercentage: Float
    bettingMaxPercentage: Float
    bettingMinAbsolute: Int
    bettingMaxAbsolute: Int
    bettingMultiplierCorrect: Float
    bettingMultiplierWrong: Float
    # Set to true to clear betting absolute values (set them to null)
    clearBettingMinAbsolute: Boolean
    clearBettingMaxAbsolute: Boolean

    allowMultipleSelection: Boolean
    answerLabelStyle: QuizAnswerLabelStyle
    predefinedAnswers: [CreatePredefinedAnswerInput!]

    minValue: Float
    maxValue: Float
    stepValue: Float

    orderingItems: [CreateOrderingItemInput!]
}

input SubmitQuizAnswerInput {
    questionId: ID!

    selectedAnswerIds: [ID!]
    textResponse: String
    numberResponse: Float
    jsonResponse: JSON
    submittedOrder: [ID!]

    timeSpentSeconds: Int
    betAmount: Int
}

input UpdateQuizAnswerInput {
    submittedOrder: [ID!]  # For ordering questions
    betAmount: Int
}

input RecordBetResultInput {
    responseId: ID!
    pointsEarned: Int!
    sendNotification: Boolean
}

input QuizFilter {
    projectId: ID
    challengeId: ID
    ids: [ID!]
}

# ==================== Quiz Pagination ====================

type QuizEdge {
    cursor: String!
    node: Quiz!
}

type QuizConnection {
    edges: [QuizEdge!]!
    pageInfo: PageInfo!
    totalCount: Int!
}

type QuizSubmissionEdge {
    cursor: String!
    node: QuizSubmission!
}

type QuizSubmissionConnection {
    edges: [QuizSubmissionEdge!]!
    pageInfo: PageInfo!
    totalCount: Int!
}

# ==================== Queries ====================

extend type Query {
    quiz(id: ID!): Quiz! @requireRole(roles: ["user", "admin", "superadmin"])
    quizzes(
        filter: QuizFilter
        first: Int
        after: String
        last: Int
        before: String
    ): QuizConnection! @requireRole(roles: ["admin", "superadmin"])

    quizSubmission(id: ID!): QuizSubmission! @requireRole(roles: ["user", "admin", "superadmin"])

    quizSubmissions(
        quizId: ID!
        userId: ID
        first: Int
        after: String
        last: Int
        before: String
    ): QuizSubmissionConnection! @requireRole(roles: ["admin", "superadmin"])
}

# ==================== Mutations ====================

extend type Mutation {
    # Admin: Quiz management
    createQuiz(input: CreateQuizInput!): Quiz! @requireRole(roles: ["admin", "superadmin"])
    updateQuiz(id: ID!, input: UpdateQuizInput!): Quiz! @requireRole(roles: ["admin", "superadmin"])
    deleteQuiz(id: ID!): Boolean! @requireRole(roles: ["admin", "superadmin"])

    # Admin: Question management
    addQuizQuestion(quizId: ID!, input: CreateQuizQuestionInput!): QuizQuestion! @requireRole(roles: ["admin", "superadmin"])
    updateQuizQuestion(id: ID!, input: UpdateQuizQuestionInput!): QuizQuestion! @requireRole(roles: ["admin", "superadmin"])
    deleteQuizQuestion(id: ID!): Boolean! @requireRole(roles: ["admin", "superadmin"])
    reorderQuizQuestions(quizId: ID!, questionIds: [ID!]!): [QuizQuestion!]! @requireRole(roles: ["admin", "superadmin"])

    # Admin: Achievement integration
    createQuizAchievement(input: CreateQuizAchievementInput!): QuizAchievement! @requireRole(roles: ["admin", "superadmin"])

    # User: Taking quizzes (via sessions - use startQuizSession)
    submitQuizAnswer(submissionId: ID!, input: SubmitQuizAnswerInput!): QuizResponse!
    updateQuizAnswer(responseId: ID!, input: UpdateQuizAnswerInput!): QuizResponse!
    finalizeQuiz(submissionId: ID!): QuizSubmission!

    # M2M: External submission
    createQuizSubmission(
        quizId: ID!
        userId: ID!
        responses: [SubmitQuizAnswerInput!]!
        completedAt: DateTime
    ): QuizSubmission! @requireRole(roles: ["m2m", "admin", "superadmin"])

    # M2M: Record bet results (points earned from betting)
    recordBetResult(input: RecordBetResultInput!): QuizResponse! @requireRole(roles: ["m2m", "admin", "superadmin"])
    recordBetResults(inputs: [RecordBetResultInput!]!): [QuizResponse!]! @requireRole(roles: ["m2m", "admin", "superadmin"])
}
