# Wayfarer Backend Configuration

# Database
# PostgreSQL connection string
DATABASE_URL=postgresql://username:password@host:5432/database?sslmode=require

# Neon Database Branching (for development)
# Project ID from your Neon dashboard
# When set, `make dev` automatically creates/uses a Neon branch matching your git branch
NEON_PROJECT_ID=your-neon-project-id

# JWT Configuration (Wayfarer-issued tokens)
# Secret key for signing and validating Wayfarer JWT tokens
JWT_SECRET=your-secret-key-for-signing-wayfarer-jwts
# Expected issuer claim for Wayfarer tokens
JWT_ISSUER=wayfarer

# Brunstad TV JWT Configuration
# For validating incoming tokens from Brunstad TV
BRUNSTAD_TV_JWT_ISSUER=https://api.brunstad.tv/
BRUNSTAD_TV_JWKS_URL=https://api.brunstad.tv/.well-known/jwks.json

# Members API Configuration
# Domain for the BCC Members API
MEMBERS_API_DOMAIN=sandbox-api.bcc.no

# Auth0 Configuration
# For Members API authentication
AUTH0_DOMAIN=bcc-sso-sandbox.eu.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret

# Development/Testing
# Optional: Brunstad TV user token for development and testing
# USER_TOKEN=your-brunstad-tv-jwt-token

# External API Keys
# API keys for external systems to submit content events
# Format: source1:key1,source2:key2
EXTERNAL_API_KEYS=example-system:example-api-key-12345,another-system:another-key-67890

# OpenTelemetry Tracing
# Enable distributed tracing for debugging (requires Jaeger running: make jaeger-up)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=wayfarer-backend
OTEL_SERVICE_VERSION=dev
OTEL_EXPORTER_ENDPOINT=localhost:4317
OTEL_EXPORTER_INSECURE=true
OTEL_SAMPLING_RATIO=1.0

# For Google Cloud Trace (Cloud Run), use:
# OTEL_EXPORTER_ENDPOINT=cloudtrace.googleapis.com:443
# OTEL_EXPORTER_INSECURE=false
# GOOGLE_CLOUD_PROJECT is auto-set by Cloud Run

# Database Query Logging
# Enable detailed SQL query logging (note: replaces OTEL database tracing when enabled)
DB_LOG_QUERIES=false

# SSF API Configuration
# Configuration for syncing content from Studies at Faith (SSF) API
SSF_API_BASE_URL=https://api.sssf.life
SSF_API_KEY=your-ssf-api-key
SSF_DEBUG_MODE=false
SSF_API_TIMEOUT=10s
SSF_SYNC_KEY=your-ssf-sync-key

# AWS S3 Configuration
# Configuration for file uploads to S3
AWS_S3_BUCKET=your-bucket-name
AWS_S3_REGION=us-east-1
AWS_S3_PUBLIC_BASE_URL=https://your-bucket-name.s3.us-east-1.amazonaws.com
AWS_S3_ACCESS_KEY_ID=your-access-key-id
AWS_S3_SECRET_ACCESS_KEY=your-secret-access-key

# Web Push Notifications (VAPID)
# Generate keys with: go run ./cmd/vapid-keygen or use webpush-go library
# Public key is also needed in frontend as NUXT_PUBLIC_VAPID_PUBLIC_KEY
VAPID_PUBLIC_KEY=your-vapid-public-key-base64-url-safe
VAPID_PRIVATE_KEY=your-vapid-private-key-base64-url-safe
# Note: Do NOT include "mailto:" prefix - webpush-go adds it automatically
VAPID_SUBJECT=admin@bcc.media

# Phrase Translation Management System
# Configuration for managing translations via Phrase TMS
PHRASE_ENABLED=false
PHRASE_BASE_URL=https://api.phrase.com/v2
PHRASE_USERNAME=your-phrase-username
PHRASE_PASSWORD=your-phrase-api-token
PHRASE_PROJECT_UID=your-phrase-project-uid
PHRASE_CALLBACK_URL=https://your-domain.com/api/translations/webhook
PHRASE_USER_UID=your-phrase-user-uid
PHRASE_DEBUG=false
# Comma-separated list of target languages (Phrase codes: da, de, en_us, fr, fi, hu, it, nl, pl, pt_br, ro, es, ru)
PHRASE_TARGET_LANGUAGES=da,de,en_us,fr,fi,hu,it,nl,pl,pt_br,ro,es,ru
# API key for authenticating export endpoint requests (like SSF_SYNC_KEY)
TRANSLATIONS_EXPORT_KEY=your-export-key-for-translation-sync

# Plugin Configuration
# Ladder to Heaven Plugin - awards bonus points for completing content before deadlines
# Set the achievement ID to enable the plugin (leave empty to disable)
PLUGIN_LADDER_TO_HEAVEN_ACHIEVEMENT_ID=
# Secret key for webhook signature verification (HMAC-SHA256)
PLUGIN_LADDER_TO_HEAVEN_SECRET_KEY=
# Challenge ID to complete when a team renames (awards 300 points per member, once only)
PLUGIN_LADDER_TO_HEAVEN_TEAM_RENAME_CHALLENGE_ID=

# Firebase Configuration
# Service account JSON - can be a file path, base64-encoded JSON, or raw JSON content
FIREBASE_SERVICE_ACCOUNT=
# Firestore database name (default: "(default)")
FIREBASE_DATABASE_NAME=(default)

# Resend Email Service
# API key for sending emails via Resend (for feedback forwarding)
RESEND_API_KEY=
# Base URL for admin panel links in emails (e.g., https://admin.example.com)
ADMIN_BASE_URL=
