# Template for the Dokploy Environment tab of the Interact compose service.
# Build-time (baked into the frontend) + runtime vars in one place —
# docker-compose.dokploy.yml maps the NUXT_PUBLIC_* ones to build args and
# passes the whole file to the container via env_file.

# --- Domain / routing ---
INTERACT_DOMAIN=interact-test.bcc.media

# --- Frontend build args (public, baked into the bundle) ---
NUXT_PUBLIC_API_URL=https://interact-test.bcc.media/graphql
NUXT_PUBLIC_TOKEN_URL=https://interact-test.bcc.media/api/token
NUXT_PUBLIC_AUTH0_DOMAIN=login.bcc.no
NUXT_PUBLIC_AUTH0_CLIENT_ID=
NUXT_PUBLIC_AUTH0_AUDIENCE=
NUXT_PUBLIC_RUDDERSTACK_WRITE_KEY=
NUXT_PUBLIC_RUDDERSTACK_DATA_PLANE_URL=
NUXT_PUBLIC_VAPID_PUBLIC_KEY=
NUXT_PUBLIC_IS_STAGING=true
NUXT_PUBLIC_FIREBASE_DATABASE=
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=
APP_VERSION=dokploy

# --- Backend runtime ---
ENVIRONMENT=staging
SERVER_PORT=8080
# Host-level Postgres provisioned by ansible/ (user/db "interact");
# host.docker.internal is mapped to the host gateway in the compose file.
DATABASE_URL=postgres://interact:CHANGE_ME@host.docker.internal:5432/interact?sslmode=disable

# Auth
AUTH0_DOMAIN=login.bcc.no
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
JWT_SECRET=
JWT_ISSUER=

# Integrations (fill in what this test env actually needs)
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_DATABASE_NAME=
EXTERNAL_API_KEYS=
RESEND_API_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_PUBLIC_BASE_URL=

# Observability (off by default on the test box)
OTEL_ENABLED=false
LOG_FORMAT=json
LOG_LEVEL=info
